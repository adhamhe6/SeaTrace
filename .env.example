# SeaTrace – example configuration.  Copy to `.env` (cp .env.example .env) before `docker compose up`.
#
# These values are PLACEHOLDERS for local, throw-away demos only. `scripts/init-env.sh` writes a `.env`
# with freshly generated random secrets instead (recommended).  Never commit `.env`.
# In SEATRACE_ENV=production the backend refuses to start with placeholder secrets.

# --- general -----------------------------------------------------------------------------------
SEATRACE_ENV=development            # development | production
SEATRACE_HTTP_PORT=8080             # host port of the web UI (http://localhost:8080)
SEATRACE_LOG_LEVEL=INFO

# --- PostgreSQL (use URL-safe characters only: letters, digits, - and _) -------------------------
POSTGRES_USER=seatrace
POSTGRES_DB=seatrace
POSTGRES_PASSWORD=change-me-db

# --- backend security --------------------------------------------------------------------------------
# Signing key for access tokens (>= 32 random characters in production).
SEATRACE_SECRET_KEY=change-me-dev-secret-key-not-for-production
# Demo accounts created/refreshed at start-up from these values.  Leave a password empty to skip the account.
SEATRACE_DEMO_OPERATOR_USERNAME=operator
SEATRACE_DEMO_OPERATOR_PASSWORD=change-me-operator
SEATRACE_DEMO_VIEWER_USERNAME=viewer
SEATRACE_DEMO_VIEWER_PASSWORD=change-me-viewer
# Browser origins allowed to call the API cross-origin (the bundled UI is same-origin and needs none).
SEATRACE_CORS_ORIGINS=http://localhost:5173

# --- simulator / OPC UA ---------------------------------------------------------------------------------
# secure = Basic256Sha256 SignAndEncrypt with development certificates (generated automatically into the `pki` volume)
# none   = unsecured endpoint, development only
SIM_SECURITY_MODE=secure
SIM_SEED=42
SIM_TICK_MS=1000
# Account the backend uses to call the simulator's control methods.
SIM_CONTROL_USER=seatrace-backend
SIM_CONTROL_PASSWORD=change-me-sim-control
